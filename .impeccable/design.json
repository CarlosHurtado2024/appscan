        "value": "0 1px 2px oklch(5% 0.02 280 / 0.4), 0 8px 24px oklch(5% 0.02 280 / 0.35)",
        "purpose": "The same sheet in the night printing."
      }
    ],
    "motion": [
      {
        "name": "fast",
        "value": "160ms cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Default state feedback on buttons, segments, stubs and previews."
      },
      {
        "name": "guilloche-sweep",
        "value": "240ms cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Prints the line work across the band after Escanear, then the camera opens. Skipped under reduced motion."
      },
      {
        "name": "camera-detection",
        "value": "200ms cubic-bezier(0.16, 1, 0.3, 1)",
        "purpose": "Glides the detected page polygon between frames."
      },
      {
        "name": "press-settle",
        "value": "translateY(1px)",
        "purpose": "Buttons and stubs settle downward on press."
      },
      {
        "name": "shutter-press",
        "value": "scale(0.92)",
        "purpose": "The camera shutter compresses on press."
      },
      {
        "name": "reduced-motion",
        "value": "animation and transition duration 1ms",
        "purpose": "Global clamp under prefers-reduced-motion."
      }
    ],
    "breakpoints": [
      {
        "name": "column-max",
        "value": "720px"
      },
      {
        "name": "rosette-min-height",
        "value": "820px"
      }
    ]
  },
  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action of a screen, usually in the fixed bottom bar.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 8V4h4M16 4h4v4M20 16v4h-4M8 20H4v-4M4 12h16\"/></svg> Escanear</button>",
      "css": ".ds-btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: var(--space-2) var(--space-4); font: inherit; font-weight: 600; border-radius: var(--radius); cursor: pointer; transition: background var(--fast), transform var(--fast); color: var(--on-primary); background: var(--primary); border: 1px solid var(--primary); } .ds-btn-primary:hover, .ds-btn-primary:active { background: var(--primary-press); } .ds-btn-primary:active { transform: translateY(1px); } .ds-btn-primary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Every supporting action, printed on the raised sheet.",
      "html": "<button class=\"ds-btn-secondary\">Importar</button>",
      "css": ".ds-btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: var(--space-2) var(--space-4); font: inherit; font-weight: 600; border-radius: var(--radius); cursor: pointer; transition: background var(--fast), transform var(--fast); color: var(--ink); background: var(--paper-raised); border: 1px solid var(--rule); } .ds-btn-secondary:hover, .ds-btn-secondary:active { background: var(--paper-sunk); } .ds-btn-secondary:active { transform: translateY(1px); } .ds-btn-secondary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Confirms a destructive action, inside the confirmation dialog only.",
      "html": "<button class=\"ds-btn-danger\">Eliminar</button>",
      "css": ".ds-btn-danger { display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2); min-height: 48px; padding: var(--space-2) var(--space-4); font: inherit; font-weight: 600; border-radius: var(--radius); cursor: pointer; transition: background var(--fast), transform var(--fast); color: var(--on-danger); background: var(--danger); border: 1px solid var(--danger); } .ds-btn-danger:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Library title search, on the raised sheet with a leading icon.",
      "html": "<label class=\"ds-input-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm5-2 5 5\"/></svg><input type=\"search\" placeholder=\"Buscar por título\" aria-label=\"Buscar por título\"></label>",
      "css": ".ds-input-search { display: flex; align-items: center; gap: var(--space-2); min-height: var(--tap); padding-inline: var(--space-3); color: var(--ink-soft); background: var(--paper-raised); border: 1px solid var(--rule); border-radius: var(--radius); } .ds-input-search:focus-within { outline: 2px solid var(--focus); } .ds-input-search input { flex: 1; min-width: 0; height: 42px; font: inherit; color: var(--ink); background: transparent; border: 0; outline: 0; } .ds-input-search input::placeholder { color: var(--ink-soft); }"
    },
    {
      "name": "Segmented Choice",
      "kind": "chip",
      "refersTo": "segment",
      "description": "Separate rectangles for filters and PDF size; the selected one fills with indigo.",
      "html": "<fieldset class=\"ds-segmented\"><label><input type=\"radio\" name=\"ds-size\" checked><span>A4</span></label><label><input type=\"radio\" name=\"ds-size\"><span>Ajustado a la imagen</span></label></fieldset>",
      "css": ".ds-segmented { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); margin: 0; padding: 0; border: 0; } .ds-segmented label { position: relative; } .ds-segmented input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; } .ds-segmented span { display: flex; align-items: center; justify-content: center; min-height: var(--tap); padding: var(--space-1) var(--space-3); text-align: center; font-size: 0.9375rem; font-weight: 600; color: var(--ink); background: var(--paper-raised); border: 1px solid var(--rule); border-radius: var(--radius); transition: background var(--fast), color var(--fast); } .ds-segmented label:hover input:not(:checked) + span { background: var(--paper-sunk); } .ds-segmented input:checked + span { color: var(--on-primary); background: var(--primary); border-color: var(--primary); } .ds-segmented input:focus-visible + span { outline: 2px solid var(--focus); outline-offset: 2px; }"
    },
    {
      "name": "Document Stub",
      "kind": "card",
      "refersTo": "stub",
      "description": "The signature row: thumbnail, perforation, then title, count and printed serial.",
      "html": "<a class=\"ds-stub\" href=\"#\"><span class=\"ds-stub-thumb\"><span class=\"ds-stub-page\"></span></span><span class=\"ds-stub-body\"><span class=\"ds-stub-title\">Factura de marzo</span><span class=\"ds-stub-meta\">2 páginas · 3 nov 2026</span><span class=\"ds-serial\">N.º D0A527</span></span></a>",
      "css": ".ds-stub { display: flex; align-items: stretch; min-height: 104px; color: var(--ink); text-decoration: none; background: var(--paper-raised); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; transition: transform var(--fast); } .ds-stub:hover { border-color: var(--ink-soft); } .ds-stub:active { transform: translateY(1px); } .ds-stub:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; } .ds-stub-thumb { flex: none; display: grid; place-items: center; width: 84px; padding: var(--space-2); background: var(--paper-sunk); border-right: 2px dashed var(--rule); } .ds-stub-page { display: block; width: 58px; height: 80px; background: #fff; box-shadow: var(--shadow); } .ds-stub-body { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; gap: 2px; padding: var(--space-3) var(--space-4); } .ds-stub-title { font-weight: 650; } .ds-stub-meta { color: var(--ink-soft); font-size: 0.875rem; } .ds-serial { color: var(--serial); font-family: var(--font-serial); font-size: 0.875rem; font-weight: 700; letter-spacing: 0.06em; }"
    },
